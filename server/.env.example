# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Secret Key for Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Optional Port (defaults to 5000)
PORT=5000

# Environment
NODE_ENV=production
